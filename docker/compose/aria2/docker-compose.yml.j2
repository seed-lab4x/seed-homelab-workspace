version: "3.8"

volumes:
  config:
    name: external_vol-aria2-config
    external: true
  downloads:
    name: external_vol-aria2-downloads
    external: true
  completed:
    name: external_vol-aria2-completed
    external: true

networks:
  aria2:

services:
  aria2-pro:
    image: p3terx/aria2-pro:latest
    env_file: external_env-all.env
    volumes:
      - config:/config
{% if VARS.PROPAGATION_DOWNLOAD is sameas true %}
      - {{ VARS.BIND_DOWNLOAD }}:/downloads:shared
{% else %}
      - {{ VARS.BIND_DOWNLOAD }}:/downloads
{% endif %}
      - completed:/downloads/completed
    networks:
      - aria2
    ports:
      - 6800:6800
      - 6888:6888
      - 6888:6888/udp
    # network_mode: bridge
    container_name: aria2-pro
    restart: always
    healthcheck:
      test: nc -z localhost 6800 || nc -z 127.0.0.1 6800 || exit 1
      interval: 60s
      timeout: 5s
      retries: 10
      start_period: 10m
